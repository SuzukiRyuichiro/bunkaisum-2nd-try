{
  "name": "worker-test",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "TAURI_BUILD=1 nuxt generate",
    "preview": "nuxt preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "postinstall": "nuxt prepare",
    "deploy": "nuxt build && bunx wrangler --cwd .output deploy",
    "drizzle:generate": "bunx drizzle-kit generate",
    "drizzle:migrate": "bunx drizzle-kit migrate",
    "drizzle:migrate:local": "bunx wrangler d1 migrations apply worker-test",
    "drizzle:studio": "bunx drizzle-kit studio",
    "drizzle:studio:local": "bunx dotenv-cli -v DATABASE_URL=$(find .wrangler/state/v3/d1/miniflare-D1DatabaseObject -type f -name '*.sqlite' -print -quit) -- bunx drizzle-kit studio --config drizzle.config.local.ts",
    "drizzle:seed": "bunx dotenv-cli -v DATABASE_URL=$(find .wrangler/state/v3/d1/miniflare-D1DatabaseObject -type f -name '*.sqlite' -print -quit) -- bunx tsx ./drizzle/seed.ts",
    "liam:generate": "tbls out -t json -o liam/schema.json $(find .wrangler/state/v3/d1/miniflare-D1DatabaseObject -type f -name '*.sqlite' -print -quit)",
    "liam:view": "bunx @liam-hq/cli erd build --format=tbls --input liam/schema.json && bunx serve dist/"
  },
  "dependencies": {
    "@internationalized/date": "^3.10.0",
    "@miniflare/d1": "^2.14.4",
    "@miniflare/shared": "^2.14.4",
    "@nuxt/icon": "^2.1.0",
    "@nuxt/ui": "^4.1.0",
    "@tauri-apps/api": "^2.10.1",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.44.7",
    "drizzle-seed": "^0.3.1",
    "groq-sdk": "^0.36.0",
    "jose": "^6.1.3",
    "nuxt": "^4.2.1",
    "nuxt-auth-utils": "^0.5.25",
    "typescript": "^5.9.3",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/better-sqlite3": "^7.6.13",
    "@vite-pwa/nuxt": "^1.1.0",
    "drizzle-kit": "^0.31.7",
    "node-gyp": "^12.2.0",
    "tsx": "^4.20.6",
    "wrangler": "^4.47.0"
  }
}
